# 企业微信回调验证测试配置文件
# 使用方法：
# 1. 复制此文件为 .env.test: cp .env.test.example .env.test
# 2. 填写以下配置信息
# 3. 运行脚本: python minimal_callback_verify.py

# ==================== 必填配置 ====================

# 微信Token（在企业微信后台配置）
# 必须与企业微信后台填写的Token完全一致
WECHAT_TOKEN=Mf2pt

# 微信EncodingAESKey（在企业微信后台配置）
# 必须与企业微信后台填写的EncodingAESKey完全一致
# 长度应为43个字符（Base64编码）
WECHAT_ENCODING_AES_KEY=GnJ2C23HEM9OcE1cgNfs3lGfX6lUKYHUViCJ1cm9YBb

# 接收者ID（receive_id）
# 对于普通应用，使用企业微信CorpID
WECHAT_RECEIVE_ID=ww7658b850fd15ddc4

# ==================== 可选配置 ====================

# 服务器地址（默认：0.0.0.0）
SERVER_HOST=0.0.0.0

# 服务器端口（默认：8024）
SERVER_PORT=8024


# 释放端口 lsof -t -i:8024 | xargs kill -9