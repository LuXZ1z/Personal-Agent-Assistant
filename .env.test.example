# 企业微信回调验证测试配置文件
# 使用方法：
# 1. 复制此文件为 .env.test: cp .env.test.example .env.test
# 2. 填写以下配置信息
# 3. 运行脚本: python minimal_callback_verify.py

# ==================== 必填配置 ====================

# 微信Token（在企业微信后台配置）
# 必须与企业微信后台填写的Token完全一致
WECHAT_TOKEN=your_token_here

# 微信EncodingAESKey（在企业微信后台配置）
# 必须与企业微信后台填写的EncodingAESKey完全一致
# 长度应为43个字符（Base64编码）
WECHAT_ENCODING_AES_KEY=your_43_chars_base64_aes_key_here

# 接收者ID（receive_id）
# 对于智能机器人，使用空字符串 ""（推荐）
# 对于普通应用，使用企业微信CorpID
WECHAT_RECEIVE_ID=

# ==================== 可选配置 ====================

# 服务器地址（默认：0.0.0.0）
SERVER_HOST=0.0.0.0

# 服务器端口（默认：8024）
SERVER_PORT=8024
